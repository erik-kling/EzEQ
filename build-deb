#!/bin/sh
set -eu
cd "$(dirname "$0")"
stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
chmod 755 "$stage"
install -Dm755 personal-eq "$stage/usr/bin/personal-eq"
install -Dm644 personal-eq.conf "$stage/usr/share/personal-eq/personal-eq.conf"
install -Dm644 personal-eq.service "$stage/usr/lib/systemd/user/personal-eq.service"
install -Dm644 personal-eq.desktop "$stage/usr/share/applications/personal-eq.desktop"
install -Dm644 personal-eq-autostart.desktop "$stage/etc/xdg/autostart/personal-eq-autostart.desktop"
mkdir -p "$stage/DEBIAN" dist
cat > "$stage/DEBIAN/control" <<'CONTROL'
Package: personal-eq
Version: 1.1.0
Section: sound
Priority: optional
Architecture: all
Maintainer: EzEQ contributors <maintainers@personal-eq.invalid>
Depends: python3, python3-gi, python3-gi-cairo, gir1.2-gtk-3.0, pipewire (>= 1.0), pipewire-bin, libpipewire-0.3-modules, pipewire-pulse, pulseaudio-utils, wireplumber, systemd
Description: Six-band stereo equalizer for desktop playback
 Adjust six frequency bands and output volume with GTK and PipeWire.
CONTROL
dpkg-deb --root-owner-group --build "$stage" dist/EzEQ_1.1.0_all.deb
